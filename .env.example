# QRaksha-Kavach Environment Configuration
# Copy this file to .env and fill in your values.

# LLM Configuration
LLM_API_KEY=your-api-key-here
LLM_API_URL=https://api.example.com/v1/chat
LLM_OFFLINE=0

# Database
DATABASE_URL=sqlite:///./qraksha.db

# App Settings
APP_ENV=development
APP_DEBUG=1
APP_HOST=0.0.0.0
APP_PORT=8000

