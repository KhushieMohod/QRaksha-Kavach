# ===========================================================================
# QRaksha-Kavach Environment Configuration Template
# ===========================================================================
# Copy this file to .env and configure your local settings:
#   cp .env.example .env
#
# IMPORTANT PRIVACY & SECURITY RULES (AGENTS.md & SPEC.md):
# - Never commit real API keys, secrets, or banking information.
# - The application must remain 100% functional with LLM_OFFLINE=1.
# - All user safety advice must come from explanations.yaml, never from LLMs.
# ===========================================================================

# ---------------------------------------------------------------------------
# LLM Integration Settings (SPEC Section 14.2)
# ---------------------------------------------------------------------------
# Set to 1 to run purely with deterministic rules (offline mode, no API calls)
LLM_OFFLINE=1

# API credentials for optional hosted LLM calls (centralized via app/llm.py)
LLM_API_KEY=your-gemini-api-key-here
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta

# LLM Timeout in seconds (fixed at 8 seconds per SPEC Section 14.2)
LLM_TIMEOUT_SECONDS=8

# ---------------------------------------------------------------------------
# Database & Persistence (SPEC Section 14.1)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./qraksha.db

# ---------------------------------------------------------------------------
# Application Server Settings
# ---------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=1
APP_HOST=0.0.0.0
APP_PORT=8000
